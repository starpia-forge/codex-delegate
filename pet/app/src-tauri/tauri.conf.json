{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codex-delegate-pet",
  "version": "0.1.0",
  "identifier": "dev.codex-delegate.pet",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Codex Delegate Pets",
      "width": 820,
      "height": 160,
      "transparent": true,
      "decorations": false,
      "shadow": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "resizable": false,
      "focus": false,
      "focusable": false,
      "visible": false
    }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
