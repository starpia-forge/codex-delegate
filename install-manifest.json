{
  "agents": {
    "claude-code": {
      "name": "Claude Code (Leader)",
      "home": ".claude",
      "homeEnv": "CLAUDE_CONFIG_DIR",
      "userDir": "skills",
      "projectDir": ".claude/skills",
      "skills": ["claude/*"],
      "modes": {
        "standard": { "exclude": [], "overlay": [] },
        "minimum": {
          "exclude": ["codex-implement", "codex-computer-use"],
          "overlay": ["claude-minimum/*"]
        }
      }
    },
    "codex": {
      "name": "Codex (workers)",
      "home": ".codex",
      "homeEnv": "CODEX_HOME",
      "userDir": "skills",
      "projectDir": ".agents/skills",
      "skills": ["codex/*"]
    }
  }
}
